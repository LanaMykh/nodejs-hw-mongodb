                    "example": "oleh1@example.com"
                  },
                  "isFavourite": {
                    "description": "Contact is favourite or not",
                    "type": "boolean",
                    "example": false
                  },
                  "contactType": {
                    "description": "Contact's type",
                    "type": "string",
                    "enum": [
                      "work",
